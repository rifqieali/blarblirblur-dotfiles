#!/usr/bin/env bash
# Dipanggil oleh systemd unit usb-automount@.service.
#   usb-automount add    /dev/sda1
#   usb-automount remove /dev/sda1
set -u

ACTION="${1:-}"
DEV="${2:-}"
LOG=/var/log/usb-automount.log
STATE=/run/usb-automount
CONF=/etc/usb-automount.conf

log() { printf '%s %s %s: %s\n' "$(date '+%F %T')" "${ACTION:-?}" "${DEV:-?}" "$*" >> "$LOG"; }

[[ -r "$CONF" ]] && . "$CONF"
: "${USER_NAME:=rifqieali}"
: "${USER_UID:=1000}"
: "${USER_GID:=1000}"
: "${USB_BASE:=/mnt/usb}"
: "${EXTERNAL_BASE:=/mnt/eksternal}"
: "${SD_BASE:=/mnt/sd}"
: "${FLASH_MAX_GB:=256}"
: "${EXTERNAL_MIN_GB:=128}"
: "${EKSTERNAL_UUIDS:=}"
: "${USB_UUIDS:=}"
: "${SKIP_FS_TYPES:=}"
: "${SKIP_LABELS:=}"

list_has() {
  local needle="$1"; shift
  local x
  for x in $*; do
    [[ "$x" == "$needle" ]] && return 0
  done
  return 1
}

mkdir -p "$STATE" "$USB_BASE" "$EXTERNAL_BASE" "$SD_BASE"
touch "$LOG" 2>/dev/null || true

DEVNAME="$(basename "$DEV")"

# ------------------------------------------------------------------- ADD ---
if [[ "$ACTION" == "add" ]]; then
  # tunggu device node siap (maks 10 detik)
  for _ in $(seq 1 50); do
    [[ -b "$DEV" ]] && break
    sleep 0.2
  done
  if [[ ! -b "$DEV" ]]; then
    log "device node belum ada, dilewati"
    exit 0
  fi

  PROPS="$(udevadm info --query=property --name "$DEV" 2>/dev/null || true)"
  if ! grep -qE '^ID_PATH=.*(usb|mmc)|^ID_USB_DRIVER=' <<<"$PROPS"; then
    case "$DEVNAME" in
      mmcblk*) ;;  # slot microSD bawaan: ID_PATH-nya pci/platform
      *) log "bukan perangkat USB/SD, dilewati"; exit 0 ;;
    esac
  fi

  FS="$(blkid -o value -s TYPE "$DEV" 2>/dev/null || true)"
  UUID="$(blkid -o value -s UUID "$DEV" 2>/dev/null || true)"
  LABEL="$(blkid -o value -s LABEL "$DEV" 2>/dev/null || true)"

  if [[ -z "$FS" ]]; then
    log "tidak ada filesystem, dilewati"
    exit 0
  fi
  if list_has "$FS" $SKIP_FS_TYPES; then
    log "filesystem $FS dilewati (SKIP_FS_TYPES)"
    exit 0
  fi
  if [[ -n "$LABEL" ]] && list_has "$LABEL" $SKIP_LABELS; then
    log "label '$LABEL' dilewati (SKIP_LABELS)"
    exit 0
  fi

  # Sudah di-mount di mana pun? Pakai itu, jangan mount dua kali.
  EXIST_MP="$(findmnt -n -o TARGET -S "$DEV" 2>/dev/null | head -1)"
  if [[ -n "$EXIST_MP" ]]; then
    printf '%s\n' "$EXIST_MP" > "$STATE/$DEVNAME"
    log "sudah ter-mount di $EXIST_MP"
    exit 0
  fi

  # Klasifikasi flash vs HDD/SSD eksternal
  DISK="$(basename "$(readlink -f "/sys/class/block/$DEVNAME/..")")"
  REMOVABLE="$(cat "/sys/block/$DISK/removable" 2>/dev/null || echo 0)"
  ROTA="$(cat "/sys/block/$DISK/queue/rotational" 2>/dev/null || echo 0)"
  SECTORS="$(cat "/sys/block/$DISK/size" 2>/dev/null || echo 0)"
  SIZE_GB=$(( SECTORS * 512 / 1024 / 1024 / 1024 ))

  if [[ -n "$UUID" ]] && list_has "$UUID" $EKSTERNAL_UUIDS; then
    BASE="$EXTERNAL_BASE"
  elif [[ -n "$UUID" ]] && list_has "$UUID" $USB_UUIDS; then
    BASE="$USB_BASE"
  elif [[ "$DEVNAME" == mmcblk* ]]; then
    BASE="$SD_BASE"
  elif [[ "$REMOVABLE" == "1" && "$SIZE_GB" -lt "$FLASH_MAX_GB" ]]; then
    BASE="$USB_BASE"
  elif [[ "$ROTA" == "1" ]]; then
    BASE="$EXTERNAL_BASE"
  elif [[ "$SIZE_GB" -ge "$EXTERNAL_MIN_GB" ]]; then
    BASE="$EXTERNAL_BASE"
  else
    BASE="$USB_BASE"
  fi

  MP="$BASE"
  mkdir -p "$MP"

  if mountpoint -q "$MP"; then
    CUR="$(findmnt -n -o SOURCE --target "$MP" 2>/dev/null || true)"
    if [[ "$CUR" == "$DEV" ]]; then
      printf '%s\n' "$MP" > "$STATE/$DEVNAME"
      log "sudah ter-mount di $MP"
      exit 0
    fi
    # Mount point utama dipakai device lain -> pakai subfolder.
    MP="$BASE/$DEVNAME"
    mkdir -p "$MP"
    if mountpoint -q "$MP"; then
      printf '%s\n' "$MP" > "$STATE/$DEVNAME"
      log "sudah ter-mount di $MP"
      exit 0
    fi
  fi

  MOUNTFS="$FS"
  case "$FS" in
    vfat)
      OPTS="rw,uid=$USER_UID,gid=$USER_GID,fmask=0133,dmask=0022,noatime" ;;
    exfat)
      OPTS="rw,uid=$USER_UID,gid=$USER_GID,umask=022,noatime" ;;
    ntfs)
      MOUNTFS="ntfs3"
      OPTS="rw,uid=$USER_UID,gid=$USER_GID,umask=022,windows_names,noatime" ;;
    ext2|ext3|ext4)
      OPTS="rw,noatime,lazytime,commit=60" ;;
    xfs)
      OPTS="rw,noatime,lazytime" ;;
    btrfs)
      OPTS="rw,noatime,lazytime,commit=60" ;;
    *)
      OPTS="rw" ;;
  esac

  if mount -t "$MOUNTFS" -o "$OPTS" "$DEV" "$MP" 2>>"$LOG"; then
    if [[ "$FS" =~ ^ext[234]$ && "$(stat -c %u "$MP" 2>/dev/null)" == "0" ]]; then
      chown "$USER_UID:$USER_GID" "$MP" 2>/dev/null || true
    fi
    printf '%s\n' "$MP" > "$STATE/$DEVNAME"
    log "mounted $DEV ($FS) at $MP"
    exit 0
  fi

  log "FAILED rw mount $DEV ($FS) at $MP"

  # NTFS dirty/hibernated: baca saja, jangan tulis.
  # 'force' di sini aman karena read-only.
  if [[ "$FS" == "ntfs" ]]; then
    if mount -t ntfs3 -o "ro,force,uid=$USER_UID,gid=$USER_GID,umask=022" \
         "$DEV" "$MP" 2>>"$LOG"; then
      printf '%s\n' "$MP" > "$STATE/$DEVNAME"
      log "mounted READ-ONLY (force) $DEV at $MP"
      exit 0
    fi
    log "FAILED ro force mount $DEV"
  fi

  # Fallback read-only generik
  if mount -t "$MOUNTFS" -o ro "$DEV" "$MP" 2>>"$LOG"; then
    printf '%s\n' "$MP" > "$STATE/$DEVNAME"
    log "mounted READ-ONLY $DEV at $MP"
    exit 0
  fi

  log "FAILED ro mount $DEV"
  rmdir "$MP" 2>/dev/null || true
  exit 1
fi

# ---------------------------------------------------------------- REMOVE ---
if [[ "$ACTION" == "remove" ]]; then
  MP="$(cat "$STATE/$DEVNAME" 2>/dev/null || true)"
  if [[ -z "$MP" ]]; then
    MP="$(findmnt -n -o TARGET -S "$DEV" 2>/dev/null | head -1)"
  fi
  if [[ -z "$MP" ]]; then
    log "tidak ada state mount, dilewati"
    exit 0
  fi

  if ! mountpoint -q "$MP"; then
    log "sudah tidak ter-mount ($MP)"
    rm -f "$STATE/$DEVNAME"
    exit 0
  fi

  # beri kesempatan proses menutup file (maks ~3 detik)
  for _ in $(seq 1 10); do
    umount "$MP" 2>/dev/null && break
    sleep 0.3
  done

  if mountpoint -q "$MP"; then
    if umount -l "$MP" 2>>"$LOG"; then
      log "lazy unmounted $MP (masih ada file terbuka)"
    else
      log "GAGAL unmount $MP"
      exit 1
    fi
  else
    log "unmounted $MP"
  fi

  rm -f "$STATE/$DEVNAME"
  case "$MP" in
    "$USB_BASE"/*|"$EXTERNAL_BASE"/*|"$SD_BASE"/*) rmdir "$MP" 2>/dev/null || true ;;
  esac
  exit 0
fi

echo "Pemakaian: usb-automount {add|remove} /dev/sdXN" >&2
exit 2
